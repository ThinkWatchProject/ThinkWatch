# === ThinkWatch — Production Environment ===
# Copy to .env.production and fill in ALL values before deploying.
# Recommended: run `deploy/generate-secrets.sh` to write .env.production
# in one shot (it picks safe random values and the right URL formats).
#
# Read by:
#   docker compose -f deploy/docker-compose.yml --env-file .env.production

# --- PostgreSQL ---
DB_USER=thinkwatch                # used by docker-compose.yml
DB_PASSWORD=CHANGE_ME             # openssl rand -hex 16
DB_NAME=think_watch
DB_MAX_CONNECTIONS=10             # read by crates/common/src/db.rs
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?sslmode=disable

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME          # used by redis container's --requirepass
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- Application ---
JWT_SECRET=CHANGE_ME              # REQUIRED: openssl rand -hex 32 (min 32 chars)
ENCRYPTION_KEY=CHANGE_ME          # REQUIRED: openssl rand -hex 32 (exactly 64 hex chars)
SERVER_HOST=0.0.0.0
GATEWAY_PORT=3000
CONSOLE_PORT=3001
CORS_ORIGINS=https://console.yourdomain.com
RUST_LOG=info,think_watch=info

# --- ClickHouse (audit log storage & search) ---
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=think_watch
CLICKHOUSE_USER=thinkwatch
CLICKHOUSE_PASSWORD=CHANGE_ME     # openssl rand -hex 16

# --- /metrics scraping ---
# Bearer token required to scrape /metrics on the public gateway port.
# When this is unset the /metrics route is NOT mounted at all (returns
# 404) — the safe default, since the endpoint leaks cost / token-usage
# / error-rate signals. `deploy/generate-secrets.sh` populates this
# automatically; only set it by hand if you're hand-rolling
# .env.production. Configure Prometheus with a matching `bearer_token`
# (or `Authorization: Bearer <value>` header).
METRICS_BEARER_TOKEN=CHANGE_ME    # openssl rand -hex 32
