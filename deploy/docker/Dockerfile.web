# Stage 1: Build
#
# Runs on the building machine's own platform rather than once per target.
# dist/ is static files, identical for every architecture, so it is built
# once, natively, and stage 2 only copies it. Built per target, arm64 ran
# `pnpm install` and `pnpm build` under QEMU: the build alone took 260s
# against 23s natively, and when Node crashed there with SIGILL the step
# never exited — the CI job sat idle until GitHub's six-hour limit.
FROM --platform=$BUILDPLATFORM node:24-alpine AS builder

# Pin pnpm to a known-good 11.x. The workspace YAML's `allowBuilds`
# field requires pnpm 11+ (see web/pnpm-workspace.yaml top comment).
# Pinning the build avoids `latest` flipping under us on a future
# image bake and producing a non-reproducible dist/.
RUN corepack enable && corepack prepare pnpm@11.0.0 --activate

WORKDIR /app
# pnpm-workspace.yaml carries the install-script allowlist (see its
# top comment). Must be copied alongside package.json so the fresh
# install in this image honors the same approvals as local + CI.
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY web/ .
RUN pnpm build

# Stage 2: Serve with Nginx
FROM nginx:1.29-alpine

# Not conf.d: files under /etc/nginx/templates are run through
# envsubst by the image's entrypoint at container start, which is how
# TRUSTED_PROXY_SECRET reaches the config without baking a secret into
# the image.
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
